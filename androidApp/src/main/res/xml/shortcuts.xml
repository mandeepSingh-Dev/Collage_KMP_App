            android:action="android.intent.action.VIEW"
            android:targetPackage="com.oem.collagekmpapp"
            android:targetClass="com.oem.collagekmpapp.MainActivity">
            <extra
                android:name="shortcut_action"
                android:value="freestyle" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_resume_draft"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_folder"
        android:shortcutShortLabel="@string/shortcut_resume_draft_short"
        android:shortcutLongLabel="@string/shortcut_resume_draft_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.oem.collagekmpapp"
            android:targetClass="com.oem.collagekmpapp.MainActivity">
